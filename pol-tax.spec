# -*- mode: python ; coding: utf-8 -*-
# PyInstaller spec, run through scripts/build.py which generates build/file_version_info.txt first
from pathlib import Path

ROOT = Path(SPECPATH)

a = Analysis(
    [str(ROOT / "main.py")],
    pathex=[str(ROOT)],
    # Generated by the build script, imported lazily so PyInstaller can't see it
    hiddenimports=["Other._version"],
    # Icons are loaded from files at runtime (Widgets/icons.py)
    datas=[(str(path), "resources") for path in (ROOT / "resources").iterdir()
           if path.suffix.lower() in (".png", ".jpg", ".svg")],
    excludes=["pytest", "tkinter"],
    noarchive=False,
)
pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name="pol-tax",
    console=False,
    icon=str(ROOT / "installer" / "pol_tax_icon.ico"),
    version=str(ROOT / "build" / "file_version_info.txt"),
)
coll = COLLECT(
    exe,
    a.binaries,
    a.datas,
    name="pol-tax",
)
